# Postgres connection string (e.g. from Vercel Storage / Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- FIGHTER GROUP INTEL / NEWS UPDATE ---

# Shared password that unlocks the public site (viewer access).
SITE_PASSWORD="change-me"

# Password for the /admin panel.
ADMIN_PASSWORD="change-me"

# Random secret used to sign session cookies. Generate your own with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Shared secret the weekly cron job must present (Authorization: Bearer <secret>).
CRON_SECRET="change-me"

# Anthropic API key used by the generation pipeline (lib/generateArticle.ts).
# Required for real (non-seeded) article generation. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
