// FIGHTER GROUP INTEL / NEWS UPDATE — data model
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  SINGAPORE
  SEA
  GLOBAL
  USA
  MALAYSIA
  INDONESIA
  CUSTOM
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AircraftCategory {
  FIGHTER_JET
  HELICOPTER
  UAV
  COMMERCIAL_AIRLINER
}

model Article {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  region           Region
  country          String? // set when region = CUSTOM (or to label MY/ID specifically)
  status           ArticleStatus @default(DRAFT)

  summaryP1        String
  summaryP2        String
  summaryP3        String? // optional third summary paragraph, for stories that need the extra depth
  didYouKnow       String
  strategicRelevance String // "Strategic Relevance in South East Asia" — senior-analyst paragraph on why this matters to the SEA security environment
  militaryPerspective String // "Military Perspective in South East Asia" — senior-analyst paragraph on operational/capability implications for SEA armed forces
  analysisHidden   Boolean @default(false) // admin can hide the Strategic Relevance / Military Perspective sections from the public article page
  singaporeImpact       String? // "Impact towards Singapore" — how this specific development concretely affects Singapore; nullable since older articles predate this field
  singaporeImpactHidden Boolean @default(true) // same hide/show toggle as analysisHidden, but defaults to HIDDEN from the public page
  bullets          String // JSON string array, 3-5 quick-brief bullets
  images           String // JSON array of {url, caption, sourceUrl}
  sources          String // JSON array of {name, url}
  reliabilityScore Int           @default(1) // number of corroborating independent sources
  articleDate      DateTime? // the underlying news story's own publish date (distinct from weekOf/publishedAt, which are about our own site)

  weekOf           DateTime // Monday of the publication week
  month            Int // 1-12, derived from weekOf, for archive grouping
  year             Int

  generatedAt      DateTime      @default(now())
  publishedAt      DateTime?
  createdBy        String        @default("bot") // "bot" | "admin"

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([region, status])
  @@index([year, month])
  @@index([weekOf])
}

model WeeklyDigest {
  id          String   @id @default(cuid())
  weekOf      DateTime @unique
  summaryText String
  articleIds  String // JSON string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RegionSetting {
  region  Region  @id
  enabled Boolean @default(true)
}

model AccessInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  label     String?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
}

enum GenerationRequestStatus {
  PENDING
  FULFILLED
  FAILED
}

// A "free workflow" generation request: created when the admin clicks
// Generate without API credits configured. Picked up and fulfilled by the
// free-generation Routine (a Claude Code session doing the research/writing
// on its own model access), which creates the actual DRAFT Article and
// links it back here.
model GenerationRequest {
  id          String                  @id @default(cuid())
  region      Region
  country     String?
  topic       String? // admin's specific search request/topic (e.g. "Vietnam submarine deal"); blank = pick any on-topic story for the region/country
  status      GenerationRequestStatus @default(PENDING)
  articleId   String?
  note        String?
  requestedAt DateTime                @default(now())
  fulfilledAt DateTime?

  @@index([status])
}

// The "free workflow" equivalent of regenerateFieldAction (lib/regenerateField.ts):
// an admin's question/instruction for rewriting one Did You Know or
// Perspective section, queued instead of calling the Anthropic API. Picked
// up by the same free-generation Routine, which rewrites the field itself
// using its own model access and updates the Article directly.
model FieldRegenerationRequest {
  id          String                  @id @default(cuid())
  articleId   String
  field       String // "didYouKnow" | "strategicRelevance" | "militaryPerspective"
  question    String
  status      GenerationRequestStatus @default(PENDING)
  note        String?
  requestedAt DateTime                @default(now())
  fulfilledAt DateTime?

  @@index([status])
}

// A one-to-two-sentence military fact, grounded in a real search-verified
// source where possible. Lifecycle mirrors Article (DRAFT -> PUBLISHED ->
// ARCHIVED): admin-requested facts land as DRAFT for review; the weekly
// Routine auto-generates and auto-publishes a fresh one each week. Only one
// row may ever be PUBLISHED at a time — that's the single fact shown to
// viewers — enforced by publishFunFact() and backed by a partial unique
// index (see migration).
model FunFact {
  id         String        @id @default(cuid())
  text       String
  topic      String? // category or the admin's prompt, e.g. "stealth technology"
  sourceName String?
  sourceUrl  String?
  status     ArticleStatus @default(DRAFT)
  createdBy  String        @default("bot") // "bot" | "admin"
  createdAt  DateTime      @default(now())

  @@index([status])
}

// The "free workflow" equivalent for fun facts: an admin's topic/question,
// queued instead of calling the Anthropic API. Picked up by the same
// free-generation Routine, which researches and writes the fact itself.
model FunFactRequest {
  id          String                  @id @default(cuid())
  topic       String? // admin's topic/question; blank = pick any topic
  status      GenerationRequestStatus @default(PENDING)
  factId      String?
  note        String?
  requestedAt DateTime                @default(now())
  fulfilledAt DateTime?

  @@index([status])
}

// An "Aircraft Recognition" card: one real, verified photo of a military or
// commercial aircraft operating in/around Asia, with an identification and a
// one-to-two line description covering its distinguishing feature(s). Mirrors
// FunFact's lifecycle exactly — DRAFT/PUBLISHED/ARCHIVED, only one card is
// ever PUBLISHED (shown to viewers) at a time, enforced by
// publishAircraftRecognition() plus a partial unique index.
model AircraftRecognition {
  id              String           @id @default(cuid())
  imageUrl        String
  imageSourceName String? // outlet/photographer credit for the photo
  imageSourceUrl  String? // where the photo was found, for verification
  aircraftName    String // e.g. "Lockheed Martin F-16C Fighting Falcon"
  category        AircraftCategory
  operator        String? // operating air force / airline / country, if known
  description     String // 1-2 lines: identification + distinct feature
  status          ArticleStatus    @default(DRAFT)
  createdBy       String           @default("bot") // "bot" | "admin"
  createdAt       DateTime         @default(now())

  @@index([status])
}

// The "free workflow" equivalent for Aircraft Recognition: an admin's
// requested aircraft/topic, queued instead of calling the Anthropic API.
// Picked up by the same free-generation Routine, which finds and verifies a
// real photo, identifies the aircraft, and writes the card itself.
model AircraftRecognitionRequest {
  id          String                  @id @default(cuid())
  topic       String? // admin's requested aircraft/topic; blank = pick any
  status      GenerationRequestStatus @default(PENDING)
  cardId      String?
  note        String?
  requestedAt DateTime                @default(now())
  fulfilledAt DateTime?

  @@index([status])
}

enum ExpertAnswerFormat {
  PARAGRAPH
  BULLETS
}

// A public viewer's free-text question submitted from the "Ask the Expert"
// box on the front page. No accounts exist on this site, so the browser
// itself tracks which questions belong to it (via a token stored in
// localStorage) and polls this row's status — there is no admin
// review/publish step, matching the same "free workflow, direct to viewer"
// treatment as FunFact/AircraftRecognition. Picked up by the hourly
// free-generation Routine, which researches and writes the answer itself.
model ExpertQuestion {
  id            String                  @id @default(cuid())
  question      String
  status        GenerationRequestStatus @default(PENDING)
  answer        String? // paragraph text, or JSON.stringify'd string[3] when answerFormat is BULLETS
  answerFormat  ExpertAnswerFormat?
  sources       String? // JSON array of {name, url}, or null if no citable source was used
  note          String? // short reason when status is FAILED
  requestedAt   DateTime                @default(now())
  fulfilledAt   DateTime?

  @@index([status])
}

enum AviationSafetyRegion {
  ASIA
  GLOBAL
  EUROPE
  NORTH_AMERICA
  CUSTOM
}

enum AviationSafetySector {
  MILITARY
  COMMERCIAL
}

// A grounded aviation-safety incident briefing for aviation personnel, scoped to ICAO
// Safety Management System (SMS) doctrine: three summary paragraphs, a source-linked
// image, a "Safety Analysis" (5-Why root-cause chain + fishbone/Ishikawa breakdown), a
// "Preventative Measures" paragraph, and — only when human error is a genuine
// contributing factor — an HFACS categorisation. Reuses ArticleStatus's DRAFT/PUBLISHED/
// ARCHIVED lifecycle; unlike FunFact/AircraftRecognition, many rows can be PUBLISHED at
// once — this behaves like Article (a growing, archived list), not a single-card widget.
model AviationSafetyArticle {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  region               AviationSafetyRegion
  country              String? // set when region = CUSTOM
  status               ArticleStatus        @default(DRAFT)
  sector               AviationSafetySector // military aviation vs commercial/civil aviation, for the trend chart split

  incidentCategory     String // e.g. "runway incursion / close proximity", "CFIT", "G-LOC", "airspace infringement"
  incidentDate         DateTime? // the event's own date — distinct from weekOf/publishedAt
  aircraftInfo         String? // aircraft type/operator involved, if applicable/known

  summaryP1            String
  summaryP2            String
  summaryP3            String
  safetyAnalysis       String // 5-Why root-cause chain + fishbone (Man/Machine/Method/Material/Environment/Management) + 5M4L breakdown
  preventativeMeasures String
  hfacsAnalysis        String? // HFACS categorisation of human-error contributing factors; null when not a human-factors event
  bullets              String @default("[]") // JSON: string[] — 5-point Quick Brief covering the summary and the safety analysis

  images               String // JSON: ArticleImage[]
  sources              String // JSON: {name,url}[]
  reliabilityScore     Int    @default(1)

  weekOf      DateTime
  month       Int
  year        Int
  generatedAt DateTime  @default(now())
  publishedAt DateTime?
  createdBy   String    @default("bot") // "bot" | "admin"

  @@index([status])
  @@index([weekOf])
}

// The "free workflow" equivalent for Aviation Safety: an admin's requested
// region/country, queued instead of calling the Anthropic API. Picked up by
// the hourly free-generation Routine, mirroring GenerationRequest.
model AviationSafetyRequest {
  id          String                  @id @default(cuid())
  region      AviationSafetyRegion
  country     String? // set when region = CUSTOM
  status      GenerationRequestStatus @default(PENDING)
  articleId   String?
  note        String?
  requestedAt DateTime                @default(now())
  fulfilledAt DateTime?

  @@index([status])
}

// The Aviation Safety section's page header: a short catchphrase plus a
// grounded, web-search-verified highlight of the Military and Commercial
// aviation safety trends observed over the past month, each paired with a
// count of the distinct real incidents found for that sector (the chart's
// data points). Auto-generated at the start of each calendar month (one row
// per month/year); the page displays the latest and charts the full history.
model AviationSafetyBrief {
  id                       String   @id @default(cuid())
  month                    Int
  year                     Int
  catchphrase              String
  militaryTrendHighlight   String
  militaryTrendTag         String @default("") // 3-6 word summary of the trend, for the chart tooltip
  militaryIncidentCount    Int
  commercialTrendHighlight String
  commercialTrendTag       String @default("") // 3-6 word summary of the trend, for the chart tooltip
  commercialIncidentCount  Int
  generatedAt              DateTime @default(now())

  @@unique([month, year])
}

enum AirbaseType {
  MILITARY
  CIVIL_MILITARY_SHARED
}

enum AirbaseUnitCategory {
  FIGHTER_SQUADRON
  TRANSPORT_SQUADRON
  HELICOPTER_SQUADRON
  UAV_SQUADRON
  AIR_DEFENSE
  SUPPORT
  AMMUNITION_DEPOT
  OTHER
}

// "Regional Knowledge" — an OSINT-compiled reference of military air bases
// (and civilian airfields that host military units) across a focused set of
// Southeast Asian countries plus South China Sea outposts/features.
// Compiled from public reporting (IISS Military Balance, official air force
// sites, GlobalSecurity.org, Wikipedia, and — for South China Sea features —
// CSIS AMTI), never from classified or non-public sources. Reuses
// ArticleStatus for admin review-gating, same as Aviation Safety: content
// lands as DRAFT for review before appearing on the public map.
model MilitaryAirbase {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  country     String // one of the 8 focus countries, or "South China Sea" for disputed/reclaimed features
  operator    String // e.g. "Republic of Singapore Air Force (RSAF)"
  latitude    Float
  longitude   Float
  icaoCode    String?
  baseType    AirbaseType   @default(MILITARY)
  description String // 1-3 sentences: role of the base, general context
  runwayDesignator String? // e.g. "18/36", identifying the runway the length/width below describe
  runwayLengthFt Int? // longest runway's length, in feet
  runwayWidthFt  Int? // that runway's width, in feet
  elevationFt    Int? // field elevation, in feet
  runwayCount    Int? // number of runways available
  sources     String // JSON: {name,url}[]
  status      ArticleStatus @default(DRAFT)
  createdBy   String        @default("bot") // "bot" | "admin"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  units AirbaseUnit[]

  @@index([status])
  @@index([country])
}

// One resident unit/asset category at a MilitaryAirbase: a flying squadron
// (with aircraft type + approximate publicly-reported strength), an air
// defense unit, a support unit, or an on-base ammunition depot. Each unit
// carries its own sources, since unit-level facts (e.g. current squadron
// tenancy) often come from a different, more specific citation than the
// base's own general description.
model AirbaseUnit {
  id           String              @id @default(cuid())
  airbaseId    String
  airbase      MilitaryAirbase     @relation(fields: [airbaseId], references: [id], onDelete: Cascade)
  category     AirbaseUnitCategory
  unitName     String // e.g. "142 Squadron 'Gryphon'" or "1st Air Defence Missile Squadron"
  aircraftType String? // e.g. "F-15SG Eagle" — null for non-flying units (air defense/support/ammo depot)
  approxCount  Int? // approximate aircraft count, if publicly reported — never a guess
  notes        String? // freeform detail, e.g. role, subordinate command, ordnance types stored
  sources      String // JSON: {name,url}[]

  @@index([airbaseId])
}
